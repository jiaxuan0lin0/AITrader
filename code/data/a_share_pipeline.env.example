# Copy this file to $AITRADER_DATA_ROOT/secrets/a_share_pipeline.env or data/secrets/a_share_pipeline.env.
# Do not commit the filled env file.
# WebDAV root is recommended. The sync script will recurse into subfolders.
USTC_WEBDAV_URL='https://pan.ustc.edu.cn/seafdav/'
USTC_WEBDAV_USERNAME='your-webdav-username'
USTC_WEBDAV_PASSWORD='your-webdav-password'

# Optional overrides. `load_a_share_env.sh` sets AITRADER_DATA_ROOT from the
# repository root before this file is sourced; keep this fallback relative.
AITRADER_DATA_ROOT="${AITRADER_DATA_ROOT:-../data}"
USTC_WEBDAV_TARGET="${AITRADER_RAW_DATA_DIR:-$AITRADER_DATA_ROOT/raw_market_data}"
A_SHARE_OUTPUT_DIR="${AITRADER_DATASETS_ROOT:-$AITRADER_DATA_ROOT/datasets}"
A_SHARE_LOG_FILE="${AITRADER_LOG_DIR:-$AITRADER_DATA_ROOT/logs}/a_share_pipeline_daily.log"
A_SHARE_SYNC_TARGET="${AITRADER_RAW_DATA_DIR:-$AITRADER_DATA_ROOT/raw_market_data}"
A_SHARE_SYNC_LOG_FILE="${AITRADER_LOG_DIR:-$AITRADER_DATA_ROOT/logs}/cloud_data_pull.log"
A_SHARE_SYNC_LOG_LEVEL='INFO'
A_SHARE_PIPELINE_LOG_LEVEL='INFO'
A_SHARE_DAILY_TIME='08:00'

# Optional incremental cloud sync window.
# With only A_SHARE_SYNC_END_DATE set, sync starts from the day after the
# latest dated local file. For example, local latest 2026-05-20 and
# A_SHARE_SYNC_END_DATE=2026-05-31 downloads 2026-05-21 through 2026-05-31.
# A_SHARE_SYNC_AUTO_START='1'
# A_SHARE_SYNC_START_DATE='2026-05-21'
# A_SHARE_SYNC_END_DATE='2026-05-31'
